---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/shared/PageHeader/PageHeader.astro';
import TimelineItem from '../components/journey/TimelineItem/TimelineItem.astro';
import { experiences, education, community, certifications, skills, languages } from '../data/journey';
import { useTranslations, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('meta.journey')}>
  <PageHeader badge={t('journey.badge')} title={t('journey.title')} subtitle={t('journey.bio')} />

  <div class="container journey">
    <section class="journey-block">
      <h2 class="journey-heading">{t('journey.experience')}</h2>
      <ol class="timeline">
        {experiences.map((e) => (
          <TimelineItem
            title={e.role[lang]}
            org={e.company}
            period={e.period[lang]}
            meta={[e.contract?.[lang], e.duration[lang], e.location[lang]].filter((x): x is string => Boolean(x))}
            desc={e.desc[lang]}
            tools={e.tools}
            current={e.current}
            currentLabel={t('journey.current')}
          />
        ))}
      </ol>
    </section>

    <div class="journey-columns">
      <section class="journey-block">
        <h2 class="journey-heading">{t('journey.education')}</h2>
        <ol class="timeline">
          {education.map((e) => (
            <TimelineItem title={e.degree[lang]} org={e.school} period={e.period} />
          ))}
        </ol>
      </section>

      <section class="journey-block">
        <h2 class="journey-heading">{t('journey.languages')}</h2>
        <ul class="simple-list">
          {languages.map((l) => (
            <li><strong>{l.name}</strong><span>{l.level[lang]}</span></li>
          ))}
        </ul>
      </section>
    </div>

    <section class="journey-block">
      <h2 class="journey-heading">{t('journey.skills')}</h2>
      <div class="skills-grid">
        {skills.map((group) => (
          <div class="skill-group">
            <h3>{group.label[lang]}</h3>
            <ul class="tags">
              {group.items[lang].map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <div class="journey-columns">
      <section class="journey-block">
        <h2 class="journey-heading">{t('journey.community')}</h2>
        <ol class="timeline">
          {community.map((c) => (
            <TimelineItem title={c.role[lang]} org={c.org} period={c.period[lang]} desc={c.desc[lang]} />
          ))}
        </ol>
      </section>

      <section class="journey-block">
        <h2 class="journey-heading">{t('journey.certifications')}</h2>
        <ul class="simple-list">
          {certifications.map((c) => (
            <li>
              <strong>{c.title[lang]}</strong>
              <span>{c.org} · {c.date[lang]}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .journey {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .journey-block {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .journey-columns {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 0 3.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .journey-columns .journey-block {
    border-bottom: none;
  }

  .journey-heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .simple-list {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .simple-list li {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
  }

  .simple-list span {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .skill-group h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  @media (max-width: 860px) {
    .journey-columns,
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
