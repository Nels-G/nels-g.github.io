---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/shared/PageHeader/PageHeader.astro';
import TimelineItem from '../components/journey/TimelineItem/TimelineItem.astro';
import {
  education,
  experiences,
  community,
  distinctions,
  skills,
  languages,
  interests,
} from '../data/journey';
import { useTranslations, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);

const label = (item: string | { fr: string; en: string }) => (typeof item === 'string' ? item : item[lang]);
---

<BaseLayout title={t('meta.journey')}>
  <PageHeader badge={t('journey.badge')} title={t('journey.title')} />

  <div class="content">
    <section class="block">
      <h2 class="section-title">{t('journey.education')}</h2>
      <ol class="timeline">
        {education.map((e) => (
          <TimelineItem
            title={e.degree[lang]}
            org={e.school}
            meta={e.location}
            period={e.period[lang]}
            details={e.details[lang]}
          />
        ))}
      </ol>
    </section>

    <section class="block">
      <h2 class="section-title">{t('journey.experience')}</h2>
      <ol class="timeline">
        {experiences.map((e) => (
          <TimelineItem
            title={e.role[lang]}
            org={e.org}
            meta={`${e.contract[lang]} · ${e.location}`}
            period={e.period[lang]}
            details={e.details[lang]}
            current={e.current}
            currentLabel={t('journey.current')}
          />
        ))}
      </ol>
    </section>

    <section class="block">
      <h2 class="section-title">{t('journey.community')}</h2>
      <ol class="timeline">
        {community.map((c) => (
          <TimelineItem
            title={c.role[lang]}
            org={c.org}
            period={c.period[lang]}
            details={c.details[lang]}
            current={c.current}
            currentLabel={t('journey.current')}
          />
        ))}
      </ol>
    </section>

    <section class="block">
      <h2 class="section-title">{t('journey.distinctions')}</h2>
      <ul class="rows">
        {distinctions.map((d) => (
          <li>
            <span>{d.title[lang]}</span>
            <span class="meta">{d.org ? `${d.org} · ` : ''}{d.date[lang]}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2 class="section-title">{t('journey.skills')}</h2>
      <dl class="skills">
        {skills.map((group) => (
          <div class="skill-row">
            <dt>{group.label[lang]}</dt>
            <dd>
              <ul class="tags">
                {group.items.map((item) => <li>{label(item)}</li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="block two-cols">
      <div>
        <h2 class="section-title">{t('journey.languages')}</h2>
        <ul class="plain">
          {languages.map((l) => (
            <li>{l.name[lang]}{l.level && <span class="meta"> · {l.level[lang]}</span>}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="section-title">{t('journey.interests')}</h2>
        <p>{interests[lang].join(', ')}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .block {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }

  .block:first-child {
    border-top: none;
    padding-top: 0;
  }

  .rows {
    list-style: none;
  }

  .rows li {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.15rem 1.5rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .rows li:last-child {
    border-bottom: none;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
  }

  .skill-row dt {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9rem;
    padding-top: 0.1rem;
  }

  .two-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .plain {
    list-style: none;
  }

  .plain li + li {
    margin-top: 0.3rem;
  }

  @media (max-width: 640px) {
    .skill-row,
    .two-cols {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .two-cols {
      gap: 2rem;
    }
  }
</style>
