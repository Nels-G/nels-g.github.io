---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/shared/PageHeader/PageHeader.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('meta.notFound')}>
  <PageHeader badge="404" title={t('notFound.title')} intro={t('notFound.desc')} />
  <p class="content">
    <a href={localizePath('/', lang)}>← {t('notFound.back')}</a>
  </p>
</BaseLayout>
