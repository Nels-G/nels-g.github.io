---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('meta.notFound')}>
  <section class="not-found container">
    <p class="not-found-code">404</p>
    <h1 class="section-title">{t('notFound.title')}</h1>
    <p class="section-subtitle">{t('notFound.desc')}</p>
    <a href={localizePath('/', lang)} class="btn btn-primary">{t('notFound.back')}</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 6rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }

  .not-found-code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 5rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .not-found .btn {
    margin-top: 1.5rem;
  }
</style>
