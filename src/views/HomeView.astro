---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);

const interests = [
  t('interests.software'),
  t('interests.quality'),
  t('interests.vision'),
  t('interests.hci'),
  t('interests.ai'),
];

const contacts = [
  { label: t('contact.email'), value: profile.email, href: `mailto:${profile.email}` },
  { label: t('contact.phone'), value: profile.phone, href: profile.whatsapp },
  { label: 'GitHub', value: 'Nels-G', href: profile.github },
  { label: 'LinkedIn', value: 'Nelson Galley', href: profile.linkedin },
];
---

<BaseLayout>
  <section class="content section bio">
    <img src={profile.photo} alt={profile.name} class="bio-photo" width="180" height="180" />
    <div>
      <div class="section-head">
        <span class="section-badge">{t('bio.badge')}</span>
        <div class="section-line"></div>
      </div>
      <h1 class="bio-name">{profile.name}</h1>
      <p class="bio-role">{t('bio.role')} <span class="meta">· {t('bio.location')}</span></p>
      <p class="bio-text">{t('bio.p1')}</p>
      <p class="bio-text">{t('bio.p2')}</p>
      <a href={localizePath('/journey', lang)} class="bio-link">{t('bio.cv')} →</a>
    </div>
  </section>

  <section class="content section">
    <div class="section-head">
      <span class="section-badge">{t('interests.badge')}</span>
      <div class="section-line"></div>
    </div>
    <ul class="interests">
      {interests.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="content section">
    <div class="section-head">
      <span class="section-badge">{t('contact.badge')}</span>
      <div class="section-line"></div>
    </div>
    <dl class="contact">
      {contacts.map((c) => (
        <div class="contact-row">
          <dt>{c.label}</dt>
          <dd>
            <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{c.value}</a>
          </dd>
        </div>
      ))}
    </dl>
  </section>
</BaseLayout>

<style>
  .bio {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .bio-photo {
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--color-accent-light);
  }

  .bio-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 2rem;
    line-height: 1.2;
  }

  .bio-role {
    font-style: italic;
    color: var(--color-accent-text);
    margin: 0.2rem 0 1.25rem;
  }

  .bio-role .meta {
    font-style: normal;
  }

  .bio-text {
    color: var(--color-text-secondary);
    margin-bottom: 0.9rem;
  }

  .bio-link {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .interests {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 2rem;
  }

  .interests li {
    position: relative;
    padding-left: 1.1rem;
  }

  .interests li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .contact-row:last-child {
    border-bottom: none;
  }

  .contact dt {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-muted);
    padding-top: 0.15rem;
  }

  .contact dd {
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .bio {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .bio-photo {
      width: 130px;
      height: 130px;
    }

    .bio-name {
      font-size: 1.6rem;
    }

    .interests {
      grid-template-columns: 1fr;
    }

    .contact-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
