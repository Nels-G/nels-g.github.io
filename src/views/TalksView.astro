---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/shared/PageHeader/PageHeader.astro';
import { talks } from '../data/talks';
import { useTranslations, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('meta.talks')}>
  <PageHeader badge={t('talks.badge')} title={t('talks.title')} intro={t('talks.intro')} />

  <div class="content">
    {talks.length === 0 ? (
      <p class="empty">{t('talks.empty')}</p>
    ) : (
      <ul class="talks">
        {talks.map((talk) => (
          <li class="talk">
            <span class="talk-date meta">{talk.date}</span>
            <div>
              <span class="section-badge">{talk.type[lang]}</span>
              <h2 class="talk-title">
                {talk.link ? (
                  <a href={talk.link} target="_blank" rel="noopener noreferrer">{talk.title[lang]}</a>
                ) : (
                  talk.title[lang]
                )}
              </h2>
              <p class="talk-meta">{talk.event[lang]} · {talk.location[lang]}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .empty {
    font-style: italic;
    color: var(--color-muted);
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .talks {
    list-style: none;
  }

  .talk {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
  }

  .talk-date {
    font-weight: 600;
    padding-top: 0.15rem;
  }

  .talk-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.4;
    margin: 0.4rem 0 0.15rem;
  }

  .talk-title a {
    color: var(--color-text);
  }

  .talk-meta {
    font-style: italic;
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .talk {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
