---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/shared/PageHeader/PageHeader.astro';
import { projects } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('meta.projects')}>
  <PageHeader badge={t('projects.badge')} title={t('projects.title')} intro={t('projects.intro')} />

  <ul class="content projects">
    {projects.map((p) => (
      <li class:list={['project', { 'has-image': p.image }]}>
        {p.image && <img src={p.image} alt={p.title[lang]} class="project-image" loading="lazy" decoding="async" />}
        <div>
          <div class="project-head">
            <h2 class="project-title">{p.title[lang]}</h2>
            <span class="meta project-period">
              {p.ongoing && <span class="status">{t('projects.ongoing')}</span>}
              {p.period[lang]}
            </span>
          </div>
          <p class="project-desc">{p.desc[lang]}</p>
          <ul class="tags" aria-label={t('projects.technologies')}>
            {p.technologies.map((tech) => <li>{tech}</li>)}
          </ul>
          {p.repo && (
            <a href={p.repo} class="project-link" target="_blank" rel="noopener noreferrer">
              {t('projects.code')} (GitHub) ↗
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .projects {
    list-style: none;
  }

  .project {
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-border);
  }

  .project.has-image {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.75rem;
  }

  .project-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }

  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .project-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .project-period {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .project-desc {
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0.85rem;
  }

  .project-link {
    display: inline-block;
    margin-top: 0.85rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.88rem;
  }

  @media (max-width: 640px) {
    .project.has-image {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
