---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Project } from '../data/projects';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
const paragraphs = project.desc[lang].split(/\n+/).map((p) => p.trim()).filter(Boolean);
---

<BaseLayout title={project.title[lang]} description={project.subtitle[lang]} image={project.image}>
  <article class="detail">
    <div class="container detail-container">
      <a href={localizePath('/projects', lang)} class="detail-back">← {t('projects.back')}</a>

      <span class="badge">{t(`projects.category.${project.category}`)}</span>
      <h1 class="detail-title">{project.title[lang]}</h1>
      <p class="detail-subtitle">{project.subtitle[lang]}</p>

      {project.liveUrl && (
        <a href={project.liveUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          {t('projects.viewLive')} ↗
        </a>
      )}

      <img class="detail-cover" src={project.image} alt={project.title[lang]} />

      <div class="detail-grid">
        <div>
          <h2 class="detail-heading">{t('projects.description')}</h2>
          {paragraphs.map((p) => <p class="detail-text">{p}</p>)}

          <h2 class="detail-heading">{t('projects.features')}</h2>
          <ul class="detail-features">
            {project.features[lang].map((f) => <li>{f}</li>)}
          </ul>
        </div>

        <aside class="detail-aside">
          <h2 class="detail-heading">{t('projects.techStack')}</h2>
          <ul class="tags">
            {project.tools[lang].map((tool) => <li>{tool}</li>)}
          </ul>
        </aside>
      </div>

      {project.gallery.length > 0 && (
        <section>
          <h2 class="detail-heading">{t('projects.gallery')}</h2>
          <div class="detail-gallery">
            {project.gallery.map((src, i) => (
              <a href={src} target="_blank" rel="noopener">
                <img src={src} alt={`${project.title[lang]} - ${i + 1}`} loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .detail {
    padding: 2.5rem 0 5rem;
  }

  .detail-container {
    max-width: 960px;
  }

  .detail-back {
    display: block;
    width: fit-content;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .detail-back:hover {
    color: var(--color-accent-dark);
  }

  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 3rem);
    line-height: 1.12;
    margin: 1rem 0 0.6rem;
  }

  .detail-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .detail-cover {
    width: 100%;
    margin: 2.5rem 0;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3rem;
  }

  .detail-heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }

  .detail-text {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .detail-text + .detail-heading,
  .detail-features + .detail-heading {
    margin-top: 2.25rem;
  }

  .detail-features {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .detail-features li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-text-secondary);
  }

  .detail-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .detail-aside {
    align-self: start;
    position: sticky;
    top: 90px;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .detail-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 1rem;
  }

  section:has(.detail-gallery) {
    margin-top: 3.5rem;
  }

  .detail-gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: 10px;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 760px) {
    .detail-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .detail-aside {
      position: static;
    }
  }
</style>
