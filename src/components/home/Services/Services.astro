---
import { useTranslations, type Lang } from '../../../i18n/utils';
import './Services.css';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);

// Outils repris de services.*.tools (fr.json / en.json)
const services = [
  {
    num: '01',
    title: t('services.uxui.title'),
    desc: t('services.uxui.desc'),
    tools: lang === 'fr' ? ['Figma', 'Prototypage', 'Wireframe'] : ['Figma', 'Prototyping', 'Wireframe'],
  },
  {
    num: '02',
    title: t('services.dev.title'),
    desc: t('services.dev.desc'),
    tools: ['React JS', 'Python', 'PostgreSQL'],
  },
  {
    num: '03',
    title: t('services.wp.title'),
    desc: t('services.wp.desc'),
    tools:
      lang === 'fr'
        ? ['WordPress', 'Site vitrine', 'Blog', 'Site e-commerce']
        : ['WordPress', 'Showcase site', 'Blog', 'E-commerce'],
  },
];
---

<section class="section services">
  <div class="container">
    <span class="badge">{t('services.badge')}</span>
    <h2 class="section-title">{t('services.title')}</h2>
    <p class="section-subtitle">{t('services.subtitle')}</p>

    <div class="services-grid">
      {services.map((s) => (
        <article class="service">
          <span class="service-num">{s.num}</span>
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.desc}</p>
          <ul class="tags">
            {s.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
