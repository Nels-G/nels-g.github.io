---
import './Footer.css';
import { useTranslations } from '../../../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="footer-name">Kossi Nelson GALLEY</p>
  <p class="footer-role">
    {t('footer.role')}
  </p>
  <p class="footer-copyright">
    © {year} Kossi Nelson GALLEY · {t('footer.rights')}
  </p>
</footer>
