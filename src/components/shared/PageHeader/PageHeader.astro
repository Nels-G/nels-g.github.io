---
import './PageHeader.css';

interface Props {
  badge: string;
  title: string;
  subtitle?: string;
}

const { badge, title, subtitle } = Astro.props;
---

<section class="page-header">
  <div class="container">
    <span class="badge">{badge}</span>
    <h1 class="section-title page-header-title">{title}</h1>
    {subtitle && <p class="section-subtitle">{subtitle}</p>}
  </div>
</section>
