---
import './TimelineItem.css';
import { useTranslations } from '../../../i18n/utils';
import type { JourneyEntry } from '../../../data/journey';

interface Props {
  entry: JourneyEntry;
  lang: 'fr' | 'en';
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);

const categoryLabels = {
  education: t('journey.category.education'),
  experience: t('journey.category.experience'),
  volunteer: t('journey.category.volunteer'),
  milestone: t('journey.category.milestone'),
};
---

<div class="timeline-item">
  <div class="timeline-marker"></div>
  <div class="timeline-content">
    <div class="timeline-meta">
      <span class="timeline-category">{categoryLabels[entry.category]}</span>
      <span class="timeline-period">{entry.period[lang]}</span>
    </div>
    <h3 class="timeline-title">
      {entry.url ? <a href={entry.url} target="_blank">{entry.title[lang]} ↗</a> : entry.title[lang]}
    </h3>
    <p class="timeline-org">{entry.org[lang]}{entry.location && ` · ${entry.location[lang]}`}</p>
    {entry.description && <p class="timeline-description">{entry.description[lang]}</p>}
  </div>
</div>
