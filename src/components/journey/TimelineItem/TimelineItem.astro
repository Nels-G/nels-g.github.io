---
import './TimelineItem.css';

interface Props {
  title: string;
  org: string;
  period: string;
  meta?: string;
  details?: string[];
  current?: boolean;
  currentLabel?: string;
}

const { title, org, period, meta, details = [], current = false, currentLabel } = Astro.props;
---

<li class="timeline-item">
  <div class="timeline-head">
    <h3 class="timeline-title">{title}</h3>
    <span class="timeline-period meta">{period}</span>
  </div>
  <p class="timeline-org">
    {org}
    {meta && <span class="meta"> · {meta}</span>}
    {current && currentLabel && <span class="status">{currentLabel}</span>}
  </p>
  {details.length > 0 && (
    <ul class="timeline-details">
      {details.map((d) => <li>{d}</li>)}
    </ul>
  )}
</li>
