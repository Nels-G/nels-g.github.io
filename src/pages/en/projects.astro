---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/shared/Header/Header.astro';
import Footer from '../../components/shared/Footer/Footer.astro';
import PageHeader from '../../components/shared/PageHeader/PageHeader.astro';
import ProjectCard from '../../components/projects/ProjectCard/ProjectCard.astro';
import { projects, otherRepos } from '../../data/projects';
import { useTranslations } from '../../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(lang);
---

<BaseLayout title="Projects · Kossi Nelson Galley" description="Personal projects by Kossi Nelson Galley in computer vision, human-computer interaction and software development.">
  <Header />

  <PageHeader badge={t('projects.badge')} title={t('projects.title')}>
    <p set:html={t('projects.intro')} />
  </PageHeader>

  <section class="projects-list">
    {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
  </section>

  {otherRepos.length > 0 && (
  <section class="other-repos">
    <h2 class="other-repos-title">{t('projects.moreOnGithub')}</h2>
    <ul class="other-repos-list">
      {otherRepos.map((repo) => (
        <li>
          <a href={repo.url} target="_blank">{repo.name}</a>
          {repo.description && <span> — {repo.description[lang]}</span>}
          {repo.language && <span class="repo-language">{repo.language}</span>}
        </li>
      ))}
    </ul>
  </section>
  )}

  <Footer />
</BaseLayout>

<style>
  .projects-list {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .other-repos {
    max-width: 900px;
    margin: 2rem auto 3rem;
    padding: 0 1.5rem;
  }
  .other-repos-title {
    font-family: var(--font-urbanist);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }
  .other-repos-list {
    list-style: none;
    font-family: var(--font-lora);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }
  .other-repos-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .other-repos-list li:last-child {
    border-bottom: none;
  }
  .other-repos-list a {
    color: var(--color-accent);
    font-family: var(--font-urbanist);
    font-weight: 500;
  }
  .repo-language {
    font-family: var(--font-urbanist);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-left: 0.5rem;
  }
</style>
