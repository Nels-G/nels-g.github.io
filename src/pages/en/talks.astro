---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/shared/Header/Header.astro';
import Footer from '../../components/shared/Footer/Footer.astro';
import PageHeader from '../../components/shared/PageHeader/PageHeader.astro';
import TalkItem from '../../components/talks/TalkItem/TalkItem.astro';
import { talks } from '../../data/talks';
import { useTranslations } from '../../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(lang);
---

<BaseLayout title="Talks · Kossi Nelson Galley" description="Talks, workshops and presentations by Kossi Nelson Galley.">
  <Header />

  <PageHeader badge={t('talks.badge')} title={t('talks.title')}>
    <p>{t('talks.intro')}</p>
  </PageHeader>

  <section class="talks-timeline">
    {talks.map((talk) => <TalkItem talk={talk} lang={lang} />)}
  </section>

  <Footer />
</BaseLayout>

<style>
  .talks-timeline {
    max-width: 900px;
    margin: 0 auto 3rem;
    padding: 0 1.5rem;
  }
</style>
