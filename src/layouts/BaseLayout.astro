---
import '../styles/global.css';
import Header from '../components/shared/Header/Header.astro';
import Footer from '../components/shared/Footer/Footer.astro';
import { FlagFr, FlagEn } from '../i18n/flags';
import { getAlternatePaths, useTranslations, type Lang } from '../i18n/utils';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);

const {
  title,
  description = t('meta.description'),
  image = profile.ogImage,
} = Astro.props;

const fullTitle = title ? `${title} | Nelson Galley` : t('meta.home');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const { fr: frPath, en: enPath } = getAlternatePaths(Astro.url.pathname);
const alternateFrURL = new URL(frPath, Astro.site);
const alternateEnURL = new URL(enPath, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: lang === 'fr' ? 'Développeur Web & UX/UI Designer' : 'Web Developer & UX/UI Designer',
  url: Astro.site?.href,
  image: new URL(profile.photo, Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Lomé', addressCountry: 'TG' },
  sameAs: [profile.github, profile.linkedin, profile.facebook],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="fr" href={alternateFrURL} />
    <link rel="alternate" hreflang="en" href={alternateEnURL} />
    <link rel="alternate" hreflang="x-default" href={alternateFrURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Urbanist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nelson Galley" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <div class="lang-gate" id="lang-gate" hidden>
      <div class="lang-gate-card" role="dialog" aria-modal="true" aria-labelledby="lang-gate-title">
        <h2 class="lang-gate-title" id="lang-gate-title">Choisissez votre langue</h2>
        <p class="lang-gate-subtitle">Choose your language</p>
        <div class="lang-gate-options">
          <button type="button" class="lang-gate-option" data-lang="fr">
            <span class="lang-gate-flag" set:html={FlagFr} />
            <span>Français</span>
          </button>
          <button type="button" class="lang-gate-option" data-lang="en">
            <span class="lang-gate-flag" set:html={FlagEn} />
            <span>English</span>
          </button>
        </div>
      </div>
    </div>

    <style>
      .lang-gate {
        position: fixed;
        inset: 0;
        background: rgba(14, 26, 23, 0.4);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1.25rem;
      }
      .lang-gate[hidden] {
        display: none;
      }
      .lang-gate-card {
        background: var(--color-surface);
        border-radius: 20px;
        padding: 2rem 1.75rem;
        max-width: 360px;
        width: 100%;
        text-align: center;
        box-shadow: 0 20px 48px rgba(0, 0, 0, 0.18);
      }
      .lang-gate-title {
        font-family: var(--font-display);
        font-size: 1.3rem;
      }
      .lang-gate-subtitle {
        color: var(--color-text-secondary);
        margin-bottom: 1.25rem;
      }
      .lang-gate-options {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .lang-gate-option {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font: 600 0.95rem var(--font-body);
        color: var(--color-text);
        background: var(--color-bg);
        border: 1.5px solid var(--color-border);
        border-radius: 12px;
        padding: 0.8rem 1rem;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      .lang-gate-option:hover {
        border-color: var(--color-accent);
        background: var(--color-accent-light);
      }
      .lang-gate-flag {
        display: flex;
        width: 26px;
        height: 18px;
        border-radius: 3px;
        overflow: hidden;
      }
      .lang-gate-flag :global(svg) {
        width: 100%;
        height: 100%;
      }
    </style>

    <script is:inline>
      (function () {
        var KEY = 'preferredLang';

        // Un clic sur le sélecteur de langue du header vaut aussi choix.
        document.querySelectorAll('[data-set-lang]').forEach(function (a) {
          a.addEventListener('click', function () {
            try {
              localStorage.setItem(KEY, a.getAttribute('data-set-lang'));
            } catch (e) {}
          });
        });

        var stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {}
        if (stored) return;

        var gate = document.getElementById('lang-gate');
        if (!gate) return;
        gate.hidden = false;

        gate.querySelectorAll('.lang-gate-option').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var chosen = btn.getAttribute('data-lang');
            try {
              localStorage.setItem(KEY, chosen);
            } catch (e) {}
            gate.hidden = true;

            var path = window.location.pathname;
            var isEn = path === '/en' || path.indexOf('/en/') === 0;
            var target = path;
            if (chosen === 'en' && !isEn) target = path === '/' ? '/en' : '/en' + path;
            else if (chosen === 'fr' && isEn) target = path.replace(/^\/en/, '') || '/';
            if (target !== path) window.location.href = target;
          });
        });
      })();
    </script>
  </body>
</html>
